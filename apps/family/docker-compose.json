{
  "services": [
    {
      "name": "family",
      "image": "ghcr.io/geymayer/family-server:0.11.0",
      "isMain": true,
      "internalPort": 8140,
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "FAMILY_BACKUP_HOUR",
          "value": "${FAMILY_BACKUP_HOUR}"
        },
        {
          "key": "FAMILY_BACKUP_KEEP",
          "value": "${FAMILY_BACKUP_KEEP}"
        },
        {
          "key": "PAIR_PAGE_PASSWORD",
          "value": "${PAIR_PAGE_PASSWORD}"
        },
        {
          "key": "PAIR_PAGE_ALLOW_REMOTE",
          "value": "${PAIR_PAGE_ALLOW_REMOTE}"
        },
        {
          "key": "FAMILY_JAVA_XMX",
          "value": "${FAMILY_JAVA_XMX}"
        },
        {
          "key": "FAMILY_GOOGLE_PLACES_KEY",
          "value": "${FAMILY_GOOGLE_PLACES_KEY}"
        },
        {
          "key": "FAMILY_DIRECTORY_REGIONS",
          "value": "${FAMILY_DIRECTORY_REGIONS}"
        },
        {
          "key": "FAMILY_RELAY",
          "value": "${FAMILY_RELAY}"
        },
        {
          "key": "FAMILY_RELAY_ADMIN_TOKEN",
          "value": "${FAMILY_RELAY_ADMIN_TOKEN}"
        },
        {
          "key": "FAMILY_MONITOR_GO2RTC",
          "value": "http://family:${FAMILY_MONITOR_HUB_PASSWORD}@family-monitor:1984"
        },
        {
          "key": "FAMILY_MONITOR_CANDIDATE",
          "value": "${FAMILY_MONITOR_CANDIDATE}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ],
      "dependsOn": [
        "family-monitor"
      ]
    },
    {
      "name": "family-monitor",
      "image": "alexxit/go2rtc:1.9.15",
      "command": [
        "go2rtc",
        "-config",
        "{\"api\":{\"listen\":\":1984\",\"username\":\"family\",\"password\":\"${FAMILY_MONITOR_HUB_PASSWORD}\"},\"rtsp\":{\"listen\":\"127.0.0.1:8554\"},\"srtp\":{\"listen\":\"\"},\"webrtc\":{\"listen\":\":8555\",\"candidates\":[\"${FAMILY_MONITOR_CANDIDATE}\"],\"ice_servers\":[]},\"log\":{\"level\":\"info\"}}",
        "-config",
        "/config/go2rtc.yaml"
      ],
      "addPorts": [
        {
          "hostPort": 8556,
          "containerPort": 8555,
          "tcp": true
        },
        {
          "hostPort": 8556,
          "containerPort": 8555,
          "udp": true
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/monitor",
          "containerPath": "/config"
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}

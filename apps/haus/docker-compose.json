{
  "services": [
    {
      "name": "haus",
      "image": "ghcr.io/geymayer/haus-server:0.5.0",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        },
        {
          "key": "PAIR_PAGE_PASSWORD",
          "value": "${PAIR_PAGE_PASSWORD}"
        },
        {
          "key": "PAIR_PAGE_ALLOW_REMOTE",
          "value": "${PAIR_PAGE_ALLOW_REMOTE}"
        },
        {
          "key": "CITIES_LOGIN",
          "value": "${CITIES_LOGIN}"
        },
        {
          "key": "CITIES_PASSWORD",
          "value": "${CITIES_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}
